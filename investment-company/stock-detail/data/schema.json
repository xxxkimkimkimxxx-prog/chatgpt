{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investment Company Stock Detail",
  "description": "個別銘柄画面用。未取得値は推測せずnullまたは項目省略。",
  "type": "object",
  "required": ["code", "name"],
  "properties": {
    "code": {"type": "string"},
    "name": {"type": "string"},
    "source": {"type": "object"},
    "price": {"type": "object"},
    "fundamentals": {
      "type": "object",
      "properties": {
        "dividendPerShare": {"type": ["number","null"]},
        "dividendYield": {"type": ["number","null"]},
        "perRange": {"type": "object"},
        "pbrRange": {"type": "object"}
      }
    },
    "valuation": {"type": "array"},
    "credit": {
      "type": "object",
      "properties": {
        "asOf": {"type": ["string","null"]},
        "ratio": {"type": ["number","null"]},
        "buyBalance10k": {"type": ["number","null"]},
        "sellBalance10k": {"type": ["number","null"]},
        "buyChange13wPct": {"type": ["number","null"]},
        "sellChange13wPct": {"type": ["number","null"]},
        "ratioRange2y": {"type": "object"},
        "history": {"type": "array"},
        "daily": {"type": "array"}
      }
    }
  }
}